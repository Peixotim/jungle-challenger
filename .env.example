NODE_ENV=development
SERVICE_NAME=wagering-processor
LOG_LEVEL=info

HOST=0.0.0.0
PORT=8080
HTTP_BODY_LIMIT=100kb
HTTP_TRUST_PROXY=false
DOCS_ENABLED=true
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
HTTP_REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=30000

POSTGRES_USER=jungle
POSTGRES_PASSWORD=jungle
POSTGRES_DB=jungle
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jungle:jungle@localhost:5432/jungle
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_REQUIRE_MIGRATED=true

PENDING_REFERENCE_MAX_ATTEMPTS=10

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/wager-events.fifo
SQS_CONSUMER_ENABLED=true
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_ATTEMPTS=5
SQS_RETRY_BASE_SECONDS=5
SQS_RETRY_MAX_SECONDS=300

WORKERS_ENABLED=true
OUTBOX_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
PENDING_REFERENCE_INTERVAL_MS=5000
PENDING_REFERENCE_BATCH_SIZE=50
